# 复制为 .env 后按需修改
# 静态站点根目录（与 conf.d 中 root 对应）；若某站点不需要静态目录，可在 compose 中注释掉对应 volume
STATIC_SITE_DARE=/var/www/dare.zhaohuijian.com
STATIC_SITE_ENOS=/var/www/enos.zhaohuijian.com

# 可选：Nginx 容器名（renew-and-reload.sh 中会用到）
# NGINX_CONTAINER=nginx-proxy

# 可选：Certbot 使用 Staging 环境（避免正式环境限频）
# CERTBOT_STAGING=1
